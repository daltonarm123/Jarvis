# Jarvis environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# ---- LLM Providers (set at least one) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Jarvis runtime ----
JARVIS_MODE=interactive          # interactive | autonomous
JARVIS_AUTONOMOUS_INTERVAL=86400 # seconds between daily briefings in autonomous mode
JARVIS_PUBLISH_INTERVAL=300       # seconds between checking scheduled posts
JARVIS_SIMULATE_POSTING=false     # true to simulate uploads during testing
LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs

# ---- Optional integrations (leave blank to disable) ----
DISCORD_TOKEN=

# Twitter
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Slack
SLACK_TOKEN=

# Email inbox for account creation and verification
EMAIL_BASE_ADDRESS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
JARVIS_EMAIL_DOMAIN=jarvis.local
