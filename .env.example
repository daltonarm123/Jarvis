# Jarvis environment configuration
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys.

# ---- Required ----
OPENAI_API_KEY=

# ---- Jarvis runtime ----
JARVIS_MODE=interactive          # interactive | autonomous
LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs

# ---- Agent models (optional overrides) ----
CONTENT_CREATOR_MODEL=gpt-4
ECOMMERCE_MODEL=gpt-4
MARKETING_MODEL=gpt-4
VIDEO_EDITOR_MODEL=gpt-3.5-turbo
STREAM_CLIPPER_MODEL=gpt-3.5-turbo
SOCIAL_POSTER_MODEL=gpt-4

# ---- Autonomous loop ----
AUTO_POST_INTERVAL=3600
DAILY_REPORT_TIME=09:00

# ---- Optional integrations (leave blank to disable) ----
# Twitter
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Instagram
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# TikTok
TIKTOK_USERNAME=
TIKTOK_PASSWORD=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Discord / Slack
DISCORD_TOKEN=
SLACK_TOKEN=
