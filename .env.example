# Jarvis environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# ---- LLM Providers (set at least one) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Jarvis runtime ----
JARVIS_MODE=interactive          # interactive | autonomous
LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs

# ---- Optional integrations (leave blank to disable) ----
DISCORD_TOKEN=

# Twitter
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Slack
SLACK_TOKEN=
